# Synthetic local defaults only. Copy to .env.local; never use in production.
SERVER_PORT=8090
JWT_ISSUER=devnogi
AUTH_SERVER_URL=http://host.docker.internal:8091
OPEN_API_BATCH_SERVER_URL=http://host.docker.internal:8092
COMMUNITY_SERVER_URL=http://host.docker.internal:8093
TECH_BLOG_SERVER_URL=http://host.docker.internal:8094
CORS_ALLOWED_ORIGINS=http://localhost:3010
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
JWT_SECRET_KEY=local-development-only-key-change-before-any-shared-use
JWT_ACCESS_TOKEN_VALIDITY=3600
JWT_REFRESH_TOKEN_VALIDITY=86400
